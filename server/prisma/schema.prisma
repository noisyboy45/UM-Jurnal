generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  articles        Article[]
  books           Book[]
  scientificWorks ScientificWork[]

  @@map("users")
}

model Article {
  id        String   @id @default(uuid())
  title     String
  content   String?
  abstract  String?
  thumbnail String?
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("articles")
}

model Book {
  id        String   @id @default(uuid())
  title     String
  author    String?
  year      String?
  synopsis  String?
  cover     String?
  pdfFile   String?
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("books")
}

model ScientificWork {
  id          String   @id @default(uuid())
  title       String
  abstract    String?
  doi         String?
  scholarLink String?
  pdfFile     String?
  userId      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("scientific_works")
}
